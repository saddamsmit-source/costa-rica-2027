+  isolation: isolate;
+  overflow: hidden;
+  border-radius: 24%;
+}
+
+.holographic-mark::after {
+  content: '';
+  pointer-events: none;
+  position: absolute;
+  inset: 3%;
+  border-radius: 23%;
+  background: linear-gradient(125deg,
+    transparent 15%, #77f3db 34%, #a39bff 47%, #ffb3cd 54%,
+    #ffd88a 61%, transparent 76%);
+  background-position: 54% 50%;
+  background-size: 205% 100%;
+  mix-blend-mode: screen;
+  opacity: .56;
+  transition: background-position .65s ease-out;
+}
+
+a:is(:hover, :focus-visible) .holographic-mark::after,
+a.holographic-mark:is(:hover, :focus-visible)::after {
+  background-position: 80% 50%;
+}
+
+html[data-motion='reduced'] .holographic-mark::after { transition: none; }
+@media (prefers-reduced-motion: reduce) {
+  .holographic-mark::after { transition: none; }
+}
+
+.reisatelier-mark { display: inline-flex; flex: 0 0 auto; }
+.world-entry { display: flex; gap: 12px; flex-wrap: wrap; margin: 16px 0 28px; }

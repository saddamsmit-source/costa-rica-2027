+const dayDate = date => date ? new Intl.DateTimeFormat('nl-NL', {
+  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
+}).format(new Date(date)) : 'Datum open';
+
+function today() {
+  const date = new Date();
+  return [date.getFullYear(), date.getMonth() + 1, date.getDate()]
+    .map(value => String(value).padStart(2, '0')).join('-');
+}
+
+function selectedDayPath(t, id = '') {
+  return '#trip/' + t.id + '/days' + (id ? '/' + id : '');
+}
+
+function openDay(t, id) {
+  location.hash = selectedDayPath(t, id);
+}
+
+function mapMarkup(picker = false) {

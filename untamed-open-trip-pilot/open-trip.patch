+      <div><h4>${esc(moment.title)}</h4>
+      ${stamp ? `<p class="moment-meta">${esc(stamp)}</p>` : ''}
+      ${moment.text ? `<p class="moment-text">${esc(moment.text)}</p>` : ''}
+      <p class="moment-meta">${pinned ? `${moment.latitude.toFixed(4)}, ${moment.longitude.toFixed(4)}` : 'Zonder pin'}</p>
+      <button type="button" data-moment="${moment.id}" class="tiny" aria-label="Bewerk ${esc(moment.title)}">Bewerken</button>
+      <button type="button" data-remove-moment="${moment.id}" class="tiny danger" aria-label="Verwijder ${esc(moment.title)}">Verwijderen</button></div>
+    </li>`;
+  });
+  return `<section class="day-journal" aria-labelledby="moment-heading">
+    <div class="section-row"><div><h3 id="moment-heading">Momenten van deze dag</h3>
+    <p class="muted">${count(moments.length, 'moment', 'momenten')} · ${count(marker, 'pin', 'pins')}</p></div>
+    <button class="primary" data-act="add-moment">+ Moment</button></div>
+    <div class="day-map-layout">${mapMarkup()}<div class="day-moment-list">${rows.length
+      ? `<ol class="moment-list">${rows.join('')}</ol>`
+      : '<p class="empty">Voeg je eerste moment toe. Je kunt meerdere plekken op één dag vastleggen.</p>'}</div></div>
+  </section>`;
+}

+    </section>`;
+  }
+  const moments = dayMoments(t, selectedDay);
+  let marker = 0;
+  const rows = moments.map(moment => {
+    const pinned = moment.latitude !== null;
+    const stamp = [moment.time, moment.date && moment.date !== day?.date ? dayDate(moment.date) : ''].filter(Boolean).join(' · ');

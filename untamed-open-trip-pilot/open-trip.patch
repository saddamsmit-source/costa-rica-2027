new file mode 100644
index 0000000..abc4182
--- /dev/null
+++ b/dist/trip-builder/moment-map.js
@@ -0,0 +1,98 @@
+const width = 720;
+const height = 360;
+let landPromise;
+
+function landPaths() {
+  landPromise ??= fetch('../brand/world-land.geojson')
+    .then(response => {
+      if (!response.ok) throw Error('Kaart kon niet laden.');
+      return response.json();
+    })
+    .then(document => document.features.flatMap(({geometry}) => {
+      const polygons = geometry.type === 'Polygon' ? [geometry.coordinates] : geometry.coordinates;
+      return polygons.map(polygon => polygon.map(ring => ring.map(([lon, lat], i) =>
+        `${i ? 'L' : 'M'}${(180 + lon).toFixed(3)},${(90 - lat).toFixed(3)}`).join('') + 'Z').join(''));
+    }))
+    .catch(error => {
+      landPromise = undefined;
+      throw error;
+    });
+  return landPromise;
+}
+
+function bounds(pins, world) {
+  if (world || !pins.length) return {left: 0, top: 0, w: 360, h: 180};
+  const xs = pins.map(pin => 180 + pin.longitude);
+  const ys = pins.map(pin => 90 - pin.latitude);
+  const x1 = Math.min(...xs), x2 = Math.max(...xs);
+  const y1 = Math.min(...ys), y2 = Math.max(...ys);
+  const w = Math.min(360, Math.max((x2 - x1) * 1.4, (y2 - y1) * 2.8, 0.15));
+  const h = w / 2;
+  return {
+    left: Math.min(360 - w, Math.max(0, (x1 + x2 - w) / 2)),
+    top: Math.min(180 - h, Math.max(0, (y1 + y2 - h) / 2)), w, h
+  };
+}
+
+const ns = 'http://www.w3.org/2000/svg';
+function svg(name, attributes) {
+  const element = document.createElementNS(ns, name);
+  for (const [attribute, value] of Object.entries(attributes)) element.setAttribute(attribute, value);
+  return element;
+}
+
+export function mountMomentMap(host, {pins = [], active = '', pick} = {}) {
+  const pinned = pins.filter(pin => Number.isFinite(pin.latitude) && Number.isFinite(pin.longitude));
+  const toggle = host.parentElement.querySelector('[data-map-toggle]');
+  const map = svg('svg', {viewBox: `0 0 ${width} ${height}`, 'aria-hidden': 'true'});
+  const land = svg('g', {class: 'moment-map-land'});
+  const marks = svg('g', {});
+  map.append(land, marks);
+  host.replaceChildren(map);
+  let world = !pinned.length;
+  let selected = pinned.find(pin => pin.id === active);
+  let view;
+
+  function paint() {
+    const pins = selected && pick ? [...pinned.filter(pin => pin.id !== selected.id), selected] : pinned;
+    view = bounds(pins, world);
+    const scale = width / view.w;
+    land.setAttribute('transform', `scale(${scale}) translate(${-view.left} ${-view.top})`);
+    marks.replaceChildren();
+    pins.forEach((pin, index) => {
+      const cx = (180 + pin.longitude - view.left) * scale;
+      const cy = (90 - pin.latitude - view.top) * scale;
+      const radius = world ? 9 : 13;
+      const group = svg('g', {class: pin.id === active ? 'map-marker selected' : 'map-marker'});
+      group.append(svg('circle', {cx, cy, r: radius}));
+      const label = svg('text', {x: cx, y: cy + 4});
+      label.textContent = index + 1;
+      group.append(label);
+      marks.append(group);
+    });
+    if (toggle) {
+      toggle.textContent = world ? 'Zoom naar punten' : 'Toon wereldkaart';
+      toggle.disabled = !pins.length;
+    }
+  }
+
+  if (toggle) toggle.addEventListener('click', () => { world = !world; paint(); });
+  if (pick) host.addEventListener('click', event => {
+    const rect = map.getBoundingClientRect();
+    const x = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
+    const y = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
+    const latitude = Number((90 - view.top - y * view.h).toFixed(5));
+    const longitude = Number((view.left + x * view.w - 180).toFixed(5));
+    selected = {id: active, latitude, longitude};
+    pick(latitude, longitude);
+    paint();
+  });
+  landPaths().then(paths => {
+    paths.forEach(d => land.append(svg('path', {d})));
+    host.dataset.ready = 'true';
+  }).catch(() => {
+    const status = host.parentElement.querySelector('[data-map-status]');
+    if (status) status.textContent = 'De kaartachtergrond is onbereikbaar. Coördinaten blijven beschikbaar.';
+  });
+  paint();
+}

+function dayJournal(t, day) {
+  if (!selectedDay) {
+    return `<section class="journal-empty">
+      <h3>${itinerary(t).length ? 'Kies de dag die je wilt vastleggen' : 'Je eerste dag ligt nog open'}</h3>

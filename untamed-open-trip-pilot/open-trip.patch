diff --git a/tests/open-trip.mjs b/tests/open-trip.mjs
new file mode 100644
index 0000000..02a81ae
--- /dev/null
+++ b/tests/open-trip.mjs
@@ -0,0 +1,57 @@
+import assert from 'node:assert/strict';
+import {KEY, blank, createTrip, addDay, itinerary, putMoment, removeMoment, routeChange,
+  validate, mergeState, load, save} from '../dist/trip-builder/model.js';
+
+let next = 0;
+const id = () => 'test-' + ++next;
+const trip = createTrip({name: 'Open proefreis'}, id);
+assert.deepEqual([trip.start, trip.end, trip.stops.length], ['', '', 0]);
+let open = addDay(trip, '2026-11-24', id);
+const dayId = itinerary(open)[0].id;
+assert.throws(() => addDay(open, '2026-11-24', id), /al een dag/);
+assert.throws(() => addDay(open, '2026-02-31', id), /reisdag/);
+
+const points = [
+  ['Ochtendmarkt', 9.934, -84.078],
+  ['Waterval', 10.002, -84.125],
+  ['Strand', 9.663, -84.657]
+];
+for (const [title, latitude, longitude] of points) {
+  open = putMoment(open, {
+    id: id(), dayId, title, text: '', date: '2026-11-24', time: '', latitude, longitude
+  });
+}
+assert.equal(new Set(open.moments.map(moment => moment.id)).size, 3);
+assert.throws(() => putMoment(open, {...open.moments[0], longitude: null}), /locatie/);
+assert.throws(() => putMoment(open, {...open.moments[0], dayId: 'missing'}), /dag/);
+assert.throws(() => putMoment(open, {...open.moments[0], latitude: 90.1}), /locatie/);
+assert.doesNotThrow(() => putMoment(open, {...open.moments[0], latitude: 0, longitude: 0}));
+assert.equal(removeMoment(open, open.moments[1].id).moments.length, 2);
+
+const linked = routeChange(open, [{id: 'stop', place: 'San José', country: 'Costa Rica', duration: 2}], id);
+assert.equal(itinerary(linked).length, 3);
+assert.equal(routeChange(linked, [], id).manualDays[0].id, dayId);
+assert.deepEqual(linked.moments, open.moments);
+
+const data = new Map();
+const storage = {getItem: key => data.get(key) ?? null, setItem: (key, value) => data.set(key, value)};
+const saved = save(storage, blank(), {...blank(), trips: [open]});
+const raw = storage.getItem(KEY);
+const snapshot = validate(JSON.parse(raw));
+assert.deepEqual(load(storage).trips[0].moments, open.moments);
+assert.deepEqual(mergeState(blank(), snapshot).state.trips[0], open);
+const quota = {getItem: storage.getItem, setItem() { throw Error('quota'); }};
+assert.throws(() => save(quota, saved, blank()), /quota/);
+assert.equal(storage.getItem(KEY), raw);
+assert.throws(() => save(storage, blank(), blank()), /ander venster/);
+assert.equal(storage.getItem(KEY), raw);
+
+const {manualDays, moments, ...v1Trip} = trip;
+const legacy = {...blank(), schemaVersion: 1, trips: [v1Trip]};
+const migrated = validate(legacy);
+assert.equal(migrated.schemaVersion, 2);
+assert.equal(legacy.schemaVersion, 1);
+assert.equal(migrated.trips[0].id, trip.id);
+assert.deepEqual(migrated.trips[0].manualDays, []);
+assert.deepEqual(migrated.trips[0].moments, []);
+console.log('PASS: name-only trip, manual day, three pins, range and reference checks, plan independence, reload, restore, storage failure and v1 migration.');

 export function mountDashboard(host,state,trips){const card=host.querySelector('.highlight-card');if(!card)return ()=>{};
  const instruments=[...host.querySelectorAll('.kpi')];let counterFrame=0;const counters=[...host.querySelectorAll('[data-count-value]')];const settleCounters=()=>{cancelAnimationFrame(counterFrame);counterFrame=0;counters.forEach(el=>el.textContent=el.dataset.countValue)};const startCounters=()=>{if(document.documentElement.dataset.motion==='reduced'||document.hidden)return;const start=performance.now();const tick=now=>{const progress=Math.min(1,(now-start)/750),ease=1-Math.pow(1-progress,3);counters.forEach(el=>el.textContent=String(Math.round(Number(el.dataset.countValue)*ease)));if(progress<1)counterFrame=requestAnimationFrame(tick);else settleCounters()};counterFrame=requestAnimationFrame(tick)};startCounters();const holographicMove=e=>{if(e.pointerType!=='mouse'||document.documentElement.dataset.motion==='reduced')return;const el=e.currentTarget,r=el.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;el.style.setProperty('--light-x',`${x*100}%`);el.style.setProperty('--light-y',`${y*100}%`);el.style.setProperty('--tilt-x',`${(y-.5)*-4}deg`);el.style.setProperty('--tilt-y',`${(x-.5)*4}deg`)};

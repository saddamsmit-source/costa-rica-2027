 export function ambientPlate(film){return `<img class="chapter-poster" src="brand/${film}-poster.jpg" alt="" decoding="async"><span class="ambient-credit">AI-SFEERBEELD</span><video class="scene-video" data-ambient-video data-src="brand/${film}-loop.mp4" muted playsinline loop preload="none" aria-hidden="true" tabindex="-1"></video>`}
-export function sceneBanner(page){const s=scenes[page];if(!s)return '';return `<section class="scene-banner scene-${page}" aria-label="${s.title}">${ambientPlate(s.film)}<div class="scene-light" aria-hidden="true"></div><div class="scene-content"><span class="eyebrow">UNTAMED PRIVATE COLLECTION · ${s.tag}</span><h2>${s.title}</h2><p>${s.detail}</p></div><span class="scene-seal" aria-hidden="true"><img src="brand/mark.svg" alt=""></span><span class="scene-credit">ARTLIST AI · SFEERBEELD</span></section>`}
-export const logoIntro=()=>`<div class="private-cinema logo-cinema"><video controls playsinline preload="metadata" poster="brand/logo-poster.jpg" src="brand/logo-intro.mp4" aria-label="Atlas Wing holografische logo-intro"></video><div class="cinema-caption"><span class="eyebrow">UNTAMED / ATLAS WING · 5 SECONDEN</span><p>Een wereld om te ontdekken.</p><span class="fine">Holografische merkintro via Artlist · zonder geluid.</span></div></div>`;

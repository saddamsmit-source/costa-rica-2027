  function mount(){cleanup();const id=location.hash.split('/')[1];if(!location.hash.startsWith('#trip/')||!trip(id))return;const date=location.hash.split('/')[3];if(/^\d{4}-\d{2}-\d{2}$/.test(date||''))requestAnimationFrame(()=>document.querySelector('#day-'+date)?.scrollIntoView({behavior:'instant',block:'start'}));scrollHandler=()=>{clearTimeout(scrollTimer);scrollTimer=setTimeout(()=>{const visible=[...document.querySelectorAll('[data-story-date]')].find(el=>{const r=el.getBoundingClientRect();return r.top<240&&r.bottom>180});if(visible&&setting(id).readDate!==visible.dataset.storyDate)saveSetting(id,{readDate:visible.dataset.storyDate,readAt:new Date().toISOString()})},250)};document.addEventListener('scroll',scrollHandler,{passive:true})}

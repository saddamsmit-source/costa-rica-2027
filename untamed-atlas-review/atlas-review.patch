+/* UNTAMED · the world as a personal travel journal. */
+:root {
+  --world-cream: #fff9ee;
+  --world-terracotta: #a74832;
+  --world-olive: #52663d;
+  --world-stamp: #855d35;
+  --world-radius: 26px;
+  --world-shadow: 0 12px 32px #513d2512;
+  --world-motion: 280ms;
+}
+
+.brand-jewel { position: relative; overflow: visible; }
+.world-logo { position: absolute; inset: -15%; width: 130%; height: 130%; opacity: 0; pointer-events: none; }
+.world-logo-ready .world-logo { opacity: 1; }
+.world-logo-ready > img { opacity: 0; }
+.sidebar .brand-jewel { width: 68px; height: 68px; flex: 0 0 68px; background: transparent; border: 0; box-shadow: none; }
+.sidebar .brand { gap: 12px; }
+.brand-small { letter-spacing: 2px; }
+.side-label { letter-spacing: 1.5px; }
+
+.dashboard-film { min-height: 430px; padding: 48px 44px; border-radius: var(--world-radius); }
+.dashboard-film h1 { max-width: 640px; font-size: clamp(48px, 5.4vw, 78px); line-height: 0.98; letter-spacing: -2px; }
+.dashboard-film h1 em { display: block; margin-top: 12px; }
+.dashboard-film p { max-width: 420px; font-size: 15px; line-height: 1.8; }
+.dashboard-film .world-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 25px; }
+.world-hero-actions .btn { min-height: 46px; border-radius: 999px; padding-inline: 23px; }
+.world-hero-actions .btn.primary { background: var(--world-cream); color: var(--forest); border-color: var(--world-cream); }
+.world-hero-actions .btn.world-secondary { background: #173f35a6; color: var(--world-cream); border-color: #f8f4eb80; }
+.world-hero-note { position: absolute; right: 34px; bottom: 35px; color: #fff3d6; text-align: right; transform: rotate(-5deg); font: italic 27px/1.1 'Cormorant Garamond', Georgia, serif; }
+.dashboard-film .atlas-edition { display: none; }
+.dashboard-film::after { background: linear-gradient(90deg, #163c30e8, #163c3066 67%, #163c3022), linear-gradient(0deg, #173d3044, transparent); }
+.dashboard-film > div:not(.world-hero-note) { position: relative; z-index: 1; }
+
+.world-facets { margin: 38px 0 30px; }
+.world-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
+.world-section-heading h2 { margin: 8px 0 0; font-size: clamp(29px, 3vw, 41px); line-height: 1.1; }
+.world-section-heading h2 em { color: var(--world-terracotta); }
+.world-handnote { flex-shrink: 0; color: var(--world-olive); font: italic 23px/1.2 'Cormorant Garamond', Georgia, serif; transform: rotate(-4deg); }
+.world-facets-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
+.world-facet { display: block; position: relative; min-width: 0; overflow: hidden; padding: 9px 9px 18px; background: var(--world-cream); border: 1px solid var(--line); border-radius: 17px; box-shadow: var(--world-shadow); color: var(--ink); text-decoration: none; transition: transform var(--world-motion) ease; }
+.world-facet img { display: block; width: 100%; height: 170px; object-fit: cover; border-radius: 11px; background: var(--sand); }
+.world-facet > div { padding: 14px 8px 0; }
+.world-facet h3 { margin: 0 0 5px; font: 600 23px/1.2 'Cormorant Garamond', Georgia, serif; }
+.world-facet p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.6; padding-right: 12px; }
+.world-facet > span { position: absolute; right: 15px; bottom: 14px; color: var(--world-terracotta); font-size: 21px; }
+.world-facet:nth-child(2) { transform: rotate(1.2deg); }
+.world-facet:nth-child(3) { transform: rotate(-1deg); }
+.world-facet:hover { transform: translateY(-4px); }
+.world-facet:focus-visible, .world-hero-actions a:focus-visible { outline: 3px solid var(--world-terracotta); outline-offset: 4px; }
+.world-image-note { margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
+
+.trip-card { border-radius: 22px; box-shadow: var(--world-shadow); }
+.trip-card .photo-badge { border: 1px solid #f4deb8ad; border-radius: 6px; transform: rotate(-4deg); letter-spacing: 1.2px; }
+.trip-card .card-action { border-top-style: dashed; }
+.journey-keepsake { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 21px 14px 12px; color: var(--world-stamp); }
+.journey-postmark { display: grid; place-items: center; width: 94px; height: 94px; flex: 0 0 94px; border: 1px solid currentColor; outline: 1px solid currentColor; outline-offset: -7px; border-radius: 50%; text-align: center; transform: rotate(-12deg); font-size: 10px; line-height: 1.6; letter-spacing: 1px; }
+.journey-keepsake svg { width: 210px; max-width: 30%; }
+.journey-handnote { color: var(--world-olive); font: italic 28px/1.15 'Cormorant Garamond', Georgia, serif; transform: rotate(-3deg); }
+.story-hero { min-height: 330px; border-radius: var(--world-radius); }
+.story-hero h1 { font-size: clamp(47px, 5vw, 72px); }
+.story-back { display: inline-block; min-height: 36px; padding: 8px 0; }
+.story-tabs { border-bottom-style: dashed; }
+
+@media (max-width: 1100px) {
+  .world-facets-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .world-facet img { height: 180px; }
+  .world-handnote { display: none; }
+}
+@media (max-width: 760px) {
+  .dashboard-film { min-height: 480px; padding: 35px 25px 100px; }
+  .dashboard-film h1 { font-size: clamp(43px, 10.5vw, 64px); letter-spacing: -1.5px; }
+  .dashboard-film p { font-size: 14px; }
+  .world-hero-note { right: 25px; bottom: 27px; font-size: 25px; }
+  .world-facets { margin-top: 30px; }
+  .world-section-heading h2 em { display: block; }
+  .world-facets-grid { gap: 12px; }
+  .world-facet { padding: 7px 7px 17px; }
+  .world-facet img { height: 135px; }
+  .world-facet h3 { font-size: 22px; }
+  .world-facet p { min-height: 58px; }
+  .world-facet > div { padding-inline: 4px; }
+  .journey-keepsake { gap: 15px; padding-inline: 2px; }
+  .journey-keepsake svg { display: none; }
+  .journey-handnote { font-size: 25px; max-width: 170px; }
+  .story-hero { min-height: 300px; }
+}
+html[data-motion=reduced] .world-facet { transition: none; }
+@media (prefers-reduced-motion: reduce) {
+  .world-facet { transition: none; }
+}
diff --git a/dist/wanderlust.js b/dist/wanderlust.js
new file mode 100644
index 0000000..48c370b
--- /dev/null
+++ b/dist/wanderlust.js
@@ -0,0 +1,151 @@
+import {getLand, projectPoint} from './globe.js';
+
+// The small brand globe shares the atlas geography and spherical projection.
+// Existing SVG marks stay visible if canvas or geography is unavailable.
+export function mountWorldLogos() {
+  const logos = [...document.querySelectorAll('.brand-jewel')].map(host => {
+    const canvas = document.createElement('canvas');
+    canvas.className = 'world-logo';
+    canvas.width = 192;
+    canvas.height = 192;
+    canvas.setAttribute('aria-hidden', 'true');
+    const context = canvas.getContext('2d');
+    host.append(canvas);
+    return {host, canvas, context};
+  }).filter(logo => logo.context);
+  if (!logos.length) return;
+
+  let polygons = [];
+  let longitude = 22;
+  let frame = 0;
+  let lastTime = 0;
+  let rotationStarted = 0;
+  const reduced = () => document.documentElement.dataset.motion !== 'full';
+
+  function draw({context: g}) {
+    const center = 96;
+    const radius = 66;
+    g.clearRect(0, 0, 192, 192);
+    g.save();
+    g.translate(center, center);
+    g.rotate(-0.42);
+    g.strokeStyle = '#d5b777';
+    g.lineWidth = 2;
+    g.beginPath();
+    g.ellipse(0, 0, 83, 30, 0, 0, Math.PI * 2);
+    g.stroke();
+    g.restore();
+
+    const sea = g.createRadialGradient(72, 67, 3, 100, 100, 72);
+    sea.addColorStop(0, '#739d7c');
+    sea.addColorStop(0.48, '#285d4b');
+    sea.addColorStop(1, '#0c3029');
+    g.fillStyle = sea;
+    g.shadowColor = '#9be0be66';
+    g.shadowBlur = 12;
+    g.beginPath();
+    g.arc(center, center, radius, 0, Math.PI * 2);
+    g.fill();
+    g.shadowBlur = 0;
+
+    function line(coordinates, color, weight) {
+      g.beginPath();
+      let connected = false;
+      for (const [lon, lat] of coordinates) {
+        const point = projectPoint(lat, lon, longitude, 15);
+        if (point.z <= 0) {
+          connected = false;
+          continue;
+        }
+        const x = center + point.x * radius;
+        const y = center - point.y * radius;
+        if (connected) g.lineTo(x, y);
+        else g.moveTo(x, y);
+        connected = true;
+      }
+      g.strokeStyle = color;
+      g.lineWidth = weight;
+      g.stroke();
+    }
+
+    for (let lon = -180; lon < 180; lon += 45) {
+      const meridian = [];
+      for (let lat = -90; lat <= 90; lat += 5) meridian.push([lon, lat]);
+      line(meridian, '#d4edcc38', 0.7);
+    }
+    for (const polygon of polygons) {
+      for (const ring of polygon) line(ring, '#f0d9a1', 1.35);
+    }
+    const sheen = g.createRadialGradient(70, 65, 0, 70, 65, 45);
+    sheen.addColorStop(0, '#fff7db40');
+    sheen.addColorStop(1, '#fff7db00');
+    g.fillStyle = sheen;
+    g.beginPath();
+    g.arc(center, center, radius, 0, Math.PI * 2);
+    g.fill();
+    g.strokeStyle = '#dbecd1b3';
+    g.lineWidth = 1.3;
+    g.stroke();
+  }
+
+  function tick(time) {
+    frame = 0;
+    if (document.hidden || reduced()) return;
+    if (!rotationStarted) rotationStarted = time;
+    if (!lastTime || time - lastTime >= 50) {
+      longitude += lastTime ? Math.min(time - lastTime, 100) * 0.003 : 0;
+      lastTime = time;
+      logos.forEach(draw);
+    }
+    // A short welcoming turn, then stillness until the next explicit resume.
+    if (time - rotationStarted < 8000) frame = requestAnimationFrame(tick);
+  }
+
+  function refresh() {
+    cancelAnimationFrame(frame);
+    frame = 0;
+    lastTime = 0;
+    rotationStarted = 0;
+    logos.forEach(draw);
+    if (polygons.length && !document.hidden && !reduced()) {
+      frame = requestAnimationFrame(tick);
+    }
+  }
+
+  getLand().then(land => {
+    polygons = land;
+    logos.forEach(logo => logo.host.classList.add('world-logo-ready'));
+    refresh();
+  }).catch(() => {});
+  document.addEventListener('untamed:motionchange', refresh);
+  document.addEventListener('visibilitychange', refresh);
+}
+
+const facets = [
+  ['mountains', 'Bergen & buitenlucht', 'Even helemaal ergens anders.', 'costa-rica/photos/dest-monteverde.jpg', '#trips'],
+  ['culture', 'Straten & verhalen', 'Dwaal rond. Proef iets nieuws.', 'costa-rica/photos/dest-sanjose.jpg', '#trips'],
+  ['ocean', 'Kust & vrijheid', 'Neem de tijd. Volg de horizon.', 'costa-rica/photos/dest-uvita.jpg', '#trips'],
+  ['wild', 'Natuur & ontmoetingen', 'Blijf kijken. Blijf je verwonderen.', 'costa-rica/photos/dest-tortuguero.jpg', '#wildlife']
+];
+
+export function worldFacetsMarkup() {
+  return `<section class="world-facets" aria-labelledby="world-facets-title">
+    <div class="world-section-heading"><div><span class="eyebrow">VOLG JE NIEUWSGIERIGHEID</span>
+    <h2 id="world-facets-title">Zoveel wereld. <em>Zoveel om te beleven.</em></h2></div>
+    <span class="world-handnote">Waar wil jij verdwalen?</span></div>
+    <div class="world-facets-grid">${facets.map(([kind, title, detail, image, href]) => `
+      <a class="world-facet world-facet-${kind}" href="${href}">
+        <img src="${image}" alt="" loading="lazy" decoding="async">
+        <div><h3>${title}</h3><p>${detail}</p></div><span aria-hidden="true">↗</span>
+      </a>`).join('')}</div>
+    <p class="world-image-note">Een voorproefje van de wereld, met beelden uit de Costa Rica-collectie.</p>
+  </section>`;
+}
+
+export function journeyKeepsakeMarkup() {
+  return `<div class="journey-keepsake" aria-hidden="true">
+    <span class="journey-postmark">EEN REIS OM<br>TE BEWAREN</span>
+    <svg viewBox="0 0 210 45" fill="none"><path d="M2 30c28-44 48 27 78-1S135 7 155 20s28 14 52-8" stroke="currentColor" stroke-dasharray="3 6"/><circle cx="3" cy="30" r="2" fill="currentColor"/><path d="m195 11 12 1-5 11" stroke="currentColor"/></svg>
+    <span class="journey-handnote">Neem de kleine momenten mee.</span>
+  </div>`;
+}
diff --git a/tests/wanderlust.mjs b/tests/wanderlust.mjs
new file mode 100644
index 0000000..ce83694
--- /dev/null
+++ b/tests/wanderlust.mjs
@@ -0,0 +1,67 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+const callbacks = new Map();
+const listeners = new Map();
+const hostClasses = new Set();
+let sequence = 0;
+let draws = 0;
+let fetches = 0;
+const context = {
+  clearRect() { draws++; },
+  save() {}, restore() {}, translate() {}, rotate() {},
+  beginPath() {}, ellipse() {}, stroke() {}, arc() {}, fill() {},
+  lineTo() {}, moveTo() {},
+  createRadialGradient() { return {addColorStop() {}}; }
+};
+const host = {append() {}, classList: {add(name) {hostClasses.add(name);}}};
+globalThis.document = {
+  hidden: false,
+  documentElement: {dataset: {motion: 'reduced'}},
+  querySelectorAll() { return [host]; },
+  createElement() {
+    return {setAttribute() {}, getContext() {return context;}};
+  },
+  addEventListener(name, callback) { listeners.set(name, callback); }
+};
+globalThis.requestAnimationFrame = callback => {
+  const id = ++sequence;
+  callbacks.set(id, callback);
+  return id;
+};
+globalThis.cancelAnimationFrame = id => callbacks.delete(id);
+globalThis.fetch = async () => {
+  fetches++;
+  return {ok: true, json: async () => JSON.parse(fs.readFileSync('dist/brand/world-land.geojson'))};
+};
+const {mountWorldLogos, worldFacetsMarkup, journeyKeepsakeMarkup} = await import('../dist/wanderlust.js');
+mountWorldLogos();
+await new Promise(resolve => setImmediate(resolve));
+assert(hostClasses.has('world-logo-ready'));
+assert(draws > 0);
+assert.equal(callbacks.size, 0, 'reduced motion renders a still globe');
+
+document.documentElement.dataset.motion = 'full';
+listeners.get('untamed:motionchange')();
+assert.equal(callbacks.size, 1);
+for (const time of [50, 8051]) {
+  const [id, callback] = callbacks.entries().next().value;
+  callbacks.delete(id);
+  callback(time);
+}
+assert.equal(callbacks.size, 0, 'welcoming turn ends after eight seconds');
+listeners.get('untamed:motionchange')();
+document.hidden = true;
+listeners.get('visibilitychange')();
+assert.equal(callbacks.size, 0, 'hidden document stops frames');
+
+const {getLand} = await import('../dist/globe.js');
+await getLand();
+assert.equal(fetches, 1, 'logo and atlas share one geography request');
+const markup = worldFacetsMarkup();
+for (const [, asset] of markup.matchAll(/src="([^"]+)"/g)) assert(fs.existsSync('dist/' + asset));
+assert.equal((markup.match(/class="world-facet world-facet-/g) || []).length, 4);
+assert(journeyKeepsakeMarkup().includes('aria-hidden="true"'));
+const worker = fs.readFileSync('dist/sw.js', 'utf8');
+assert(worker.includes("'wanderlust.css','wanderlust.js'"));
+console.log('PASS: spherical logo, shared geography, finite animation, reduced motion, hidden-page pause, image references and offline shell entries.');
